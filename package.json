{
  "name": "spine-sequence-exporter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite --mode electron",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "build:standalone": "npm run build:web && node scripts/build-standalone.mjs",
    "build:electron": "vite build --mode electron",
    "dist": "npm run build:electron && electron-builder --win nsis",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "dist:installer": "npm run build:electron && electron-builder --win nsis --config.directories.output=release-installer-final",
    "dist:portable": "npm run build:electron && electron-builder --win portable",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.spine-sequence-exporter.app",
    "productName": "Spine序列帧导出工具",
    "executableName": "SpineSequenceExporter",
    "electronVersion": "28.3.3",
    "directories": {
      "output": "release-installer-v2"
    },
    "files": [
      "dist/**/*",
      "dist-electron/*.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spine序列帧导出工具",
      "artifactName": "SpineSequenceExporter-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "SpineSequenceExporter-${version}-Portable.${ext}"
    }
  }
}
